# ---------------------------------------------------------------------------
# Базовая конфигурация. Копируется в .env и заполняется реальными значениями.
# ВСЁ ОСТАЛЬНОЕ (адреса, проценты, лимиты, тексты) настраивается в админке бота.
# ---------------------------------------------------------------------------

# Токен бота от @BotFather
BOT_TOKEN=123456:AA...

# Telegram ID главных администраторов через запятую.
# Эти ID нельзя разжаловать из бота — они всегда имеют полный доступ.
ADMIN_IDS=123456789

# База данных.
# SQLite (по умолчанию):   sqlite+aiosqlite:///data/guarant.db
# PostgreSQL:              postgresql+asyncpg://user:pass@localhost:5432/guarant
DATABASE_URL=sqlite+aiosqlite:///data/guarant.db

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
